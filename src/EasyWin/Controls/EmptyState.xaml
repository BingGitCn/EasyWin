<UserControl x:Class="EasyWin.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="64" Height="64" CornerRadius="16" HorizontalAlignment="Center"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <ui:SymbolIcon Symbol="{Binding ElementName=Root, Path=Symbol}" FontSize="26"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Border>
        <TextBlock Text="{Binding ElementName=Root, Path=Title}" FontSize="15" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,14,0,0"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock Text="{Binding ElementName=Root, Path=Caption}" FontSize="12" TextWrapping="Wrap"
                   MaxWidth="380" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        <ContentPresenter Content="{Binding ElementName=Root, Path=Actions}"
                          Margin="0,14,0,0" HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
