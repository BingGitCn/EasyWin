<Page x:Class="EasyWin.Views.NetToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="700"
      d:DesignWidth="1000">

        <StackPanel Margin="24,8,24,24" MaxWidth="860" HorizontalAlignment="Left">

            <TextBlock Text="网络工具" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="系统代理、hosts 编辑与 DNS 维护" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />

            <!-- 系统代理 -->
            <TextBlock Text="系统代理(HTTP)" Style="{StaticResource SectionTitleText}" />
            <ui:Card Padding="18">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="启用代理" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13" />
                            <ui:ToggleSwitch IsChecked="{Binding ProxyEnabled, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock Text="修改后立即生效,无需重启浏览器" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="代理服务器(地址:端口)" Style="{StaticResource FieldLabelText}" />
                            <ui:TextBox Text="{Binding ProxyServer, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="127.0.0.1:7890" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="例外(分号分隔)" Style="{StaticResource FieldLabelText}" />
                            <ui:TextBox Text="{Binding ProxyOverride, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="localhost;192.168.*" />
                        </StackPanel>
                    </Grid>

                    <DockPanel Margin="0,12,0,0">
                        <ui:Button DockPanel.Dock="Right" Content="保存代理设置" Icon="{ui:SymbolIcon Save24}" Appearance="Primary"
                                   Command="{Binding SaveProxyCommand}" />
                        <TextBlock Text="{Binding AutoConfigUrl, StringFormat=当前 PAC 脚本:{0}}"
                                   Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Visibility="{Binding AutoConfigUrl, Converter={StaticResource NotNullToVis}}" />
                    </DockPanel>
                </StackPanel>
            </ui:Card>

            <!-- hosts -->
            <TextBlock Text="hosts 文件" Style="{StaticResource SectionTitleText}" />
            <ui:Card Padding="18">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <ui:Button DockPanel.Dock="Right" Content="保存" Icon="{ui:SymbolIcon Save24}" Appearance="Primary"
                                   Command="{Binding SaveHostsCommand}" />
                        <TextBlock Text="C:\Windows\System32\drivers\etc\hosts · 保存前自动备份" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ui:TextBox Text="{Binding HostsText, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="True"
                                TextWrapping="NoWrap"
                                FontFamily="Consolas"
                                FontSize="13"
                                MinHeight="240"
                                Height="240"
                                VerticalContentAlignment="Top"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Auto" />
                </StackPanel>
            </ui:Card>

            <!-- 端口占用 -->
            <TextBlock Text="端口占用" Style="{StaticResource SectionTitleText}" />
            <ui:Card Padding="18">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,10,0"
                                             Visibility="{Binding IsCheckingPort, Converter={StaticResource BoolToVis}}" />
                            <ui:Button Content="查询" Icon="{ui:SymbolIcon Search24}" Appearance="Primary"
                                       Command="{Binding CheckPortCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="端口号" Style="{StaticResource FieldLabelText}" />
                            <ui:TextBox Width="200" HorizontalAlignment="Left"
                                        Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="例如 8080" MaxLength="5" />
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding PortUsages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="12,8" Margin="0,0,0,6"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Content="结束进程" Icon="{ui:SymbolIcon Dismiss24}"
                                                   Appearance="Danger" Padding="8,4" VerticalAlignment="Center"
                                                   Command="{Binding DataContext.KillPortProcessCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Summary}" FontSize="13" FontFamily="Consolas" />
                                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0">
                                                <Run Text="{Binding ProcessName, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding ProcessId, Mode=OneWay, StringFormat='PID {0}'}" />
                                                <Run Text="{Binding ProcessPath, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="输入端口号点「查询」,列出该端口被哪个进程占用;空闲则无结果"
                               Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                </StackPanel>
            </ui:Card>

            <!-- DNS 维护 -->
            <TextBlock Text="DNS 与网络修复" Style="{StaticResource SectionTitleText}" />
            <ui:Card Padding="18">
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="刷新 DNS 缓存" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Secondary"
                               Margin="0,0,10,0" Command="{Binding FlushDnsCommand}" />
                    <ui:Button Content="重置 Winsock(需重启)" Icon="{ui:SymbolIcon Warning24}" Appearance="Danger"
                               Command="{Binding ResetWinsockCommand}" />
                    <TextBlock Text="无法上网时可尝试重置 Winsock,重启电脑后生效" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
            </ui:Card>

        </StackPanel>
</Page>
