<Page x:Class="EasyWin.Views.CleanerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="800"
      d:DesignWidth="1000">

    <StackPanel Margin="24,8,24,24" MaxWidth="900" HorizontalAlignment="Left">

        <TextBlock Text="清理" Style="{StaticResource PageTitleText}" />
        <TextBlock Text="只清理明确列出的目标——不碰注册表「深度清理」,勾选了才动手;被占用的文件自动跳过"
                   Style="{StaticResource CaptionText}" Margin="0,4,0,0" />

        <!--  操作栏  -->
        <ui:Card Padding="14" Margin="0,12,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button DockPanel.Dock="Right" Content="重新扫描" Icon="{ui:SymbolIcon ArrowSync24}"
                               Appearance="Secondary" Margin="0,0,10,0"
                               IsEnabled="{Binding IsNotBusy}" Command="{Binding ScanAllCommand}" />
                    <ui:Button Content="清理所选" Icon="{ui:SymbolIcon Delete24}"
                               Appearance="Primary" Padding="22,6"
                               IsEnabled="{Binding IsNotBusy}" Command="{Binding CleanSelectedCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            </DockPanel>
        </ui:Card>

        <!--  清理目标列表  -->
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:Card Margin="0,0,0,10" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,14,0" />

                            <Border Grid.Column="1" Width="42" Height="42" CornerRadius="8"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    VerticalAlignment="Center" Margin="0,0,14,0">
                                <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="20" />
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Description}" FontSize="12" LineHeight="17"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>

                            <Border Grid.Column="3" CornerRadius="10" Padding="10,3" VerticalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <TextBlock Text="{Binding SizeText}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="提示:浏览器缓存清理前请先关闭对应浏览器;临时文件夹只清理 24 小时前的旧文件;回收站与最近使用记录清理后不可恢复。"
                   Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />

    </StackPanel>
</Page>
