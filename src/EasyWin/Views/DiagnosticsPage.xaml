<Page x:Class="EasyWin.Views.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:EasyWin.Controls"
      mc:Ignorable="d"
      d:DesignHeight="1600"
      d:DesignWidth="1000">

    <StackPanel Margin="24,8,24,24" MaxWidth="900" HorizontalAlignment="Left">

        <TextBlock Text="网络诊断" Style="{StaticResource PageTitleText}" />
        <TextBlock Text="Ping 监视 · 路由跟踪 · DNS 查询 · 端口扫描 · HTTP 头 · 本机网络状态 · 子网计算"
                   Style="{StaticResource CaptionText}" Margin="0,4,0,0" />

        <!--  ============ Ping 监视  ============  -->
        <TextBlock Text="Ping 监视" Style="{StaticResource SectionTitleText}" />
        <ui:Card Padding="16" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" MinWidth="96" Margin="12,0,0,0"
                               Content="{Binding PingButtonText}" Appearance="Primary"
                               Command="{Binding TogglePingCommand}" />
                    <ui:TextBox Text="{Binding PingHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="目标 IP 或域名" />
                </DockPanel>
                <TextBlock Text="{Binding PingStatsText}" Style="{StaticResource CaptionText}" Margin="0,10,0,0" />
                <controls:Sparkline Values="{Binding PingValues}" Height="64" Margin="0,8,0,0" />
            </StackPanel>
        </ui:Card>

        <!--  ============ 路由跟踪  ============  -->
        <TextBlock Text="路由跟踪" Style="{StaticResource SectionTitleText}" />
        <ui:Card Padding="16" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="开始跟踪" Appearance="Primary" MinWidth="96" Margin="12,0,0,0"
                               IsEnabled="{Binding IsNotTracing}" Command="{Binding RunTraceCommand}" />
                    <ui:TextBox Text="{Binding TraceHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="目标 IP 或域名,最多 30 跳" />
                </DockPanel>
                <TextBlock Text="{Binding TraceProgressText}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                <ItemsControl ItemsSource="{Binding TraceHops}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Hop, StringFormat=第 {0} 跳}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Address}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="2" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding LatencyMs, StringFormat={}{0} ms}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TimedOut}" Value="True">
                                                    <Setter Property="Text" Value="超时" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:Card>

        <!--  ============ DNS 查询  ============  -->
        <TextBlock Text="DNS 查询" Style="{StaticResource SectionTitleText}" />
        <ui:Card Padding="16" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ComboBox Width="96" ItemsSource="{Binding DnsTypes}" SelectedItem="{Binding DnsType, Mode=TwoWay}" />
                        <ui:Button Content="查询" Appearance="Primary" MinWidth="80" Margin="12,0,0,0"
                                   IsEnabled="{Binding IsNotDnsBusy}" Command="{Binding RunDnsCommand}" />
                    </StackPanel>
                    <ui:TextBox Text="{Binding DnsDomain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="域名,如 example.com" />
                </DockPanel>
                <TextBlock Text="{Binding DnsMessage}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                <ItemsControl ItemsSource="{Binding DnsRecords}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <Border CornerRadius="4" Padding="7,1" Background="#334C9CE2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Type}" FontSize="11" FontWeight="SemiBold" Foreground="#6FB4E8" />
                                </Border>
                                <TextBlock Text="{Binding Value}" FontSize="12" Margin="10,0,0,0" MaxWidth="620"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Ttl}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:Card>

        <!--  ============ 端口扫描  ============  -->
        <TextBlock Text="端口扫描" Style="{StaticResource SectionTitleText}" />
        <ui:Card Padding="16" Margin="0,0,0,10">
            <StackPanel>
                <ui:TextBox Text="{Binding ScanHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="目标 IP 或域名" MaxWidth="360" HorizontalAlignment="Left" />
                <DockPanel Margin="0,10,0,0">
                    <ui:Button DockPanel.Dock="Right" Content="开始扫描" Appearance="Primary" MinWidth="96" Margin="12,0,0,0"
                               IsEnabled="{Binding IsNotScanBusy}" Command="{Binding RunPortScanCommand}" />
                    <ui:TextBox Text="{Binding ScanPortsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="端口列表,支持 80,443 和 1000-2000 混写" />
                </DockPanel>
                <TextBlock Text="{Binding ScanProgressText}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding ScanResultText}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </ui:Card>

        <!--  ============ HTTP 响应头  ============  -->
        <TextBlock Text="HTTP 响应头" Style="{StaticResource SectionTitleText}" />
        <ui:Card Padding="16" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="获取" Appearance="Primary" MinWidth="96" Margin="12,0,0,0"
                               IsEnabled="{Binding IsNotHttpBusy}" Command="{Binding RunHttpCommand}" />
                    <ui:TextBox Text="{Binding HttpUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="网址,如 example.com(自动补 https://)" />
                </DockPanel>
                <TextBlock Text="{Binding HttpMessage}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                <ItemsControl ItemsSource="{Binding HttpHeaders}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:Card>

        <!--  ============ 本机网络状态  ============  -->
        <TextBlock Text="本机网络状态" Style="{StaticResource SectionTitleText}" />
        <ui:Card Padding="16" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Secondary"
                               IsEnabled="{Binding IsNotNetStateBusy}" Command="{Binding RefreshNetStateCommand}" />
                    <TextBlock Text="{Binding NetStateMessage}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                </DockPanel>

                <!--  ARP 表  -->
                <TextBlock Text="ARP 表(IP ↔ MAC)" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,6" />
                <ItemsControl ItemsSource="{Binding ArpEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Col1}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Col2}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Col3}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  TCP 连接  -->
                <TextBlock Text="活动 TCP 连接" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,6" />
                <ItemsControl ItemsSource="{Binding TcpConnections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Col1}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Col2}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Col3}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding Col4}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="4" Text="{Binding Col5}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  监听端口  -->
                <TextBlock Text="本机监听端口" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,6" />
                <ItemsControl ItemsSource="{Binding ListeningPorts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Col1}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Col2}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Col3}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding Col4}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="4" Text="{Binding Col5}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:Card>

        <!--  ============ 子网计算器  ============  -->
        <TextBlock Text="子网计算器" Style="{StaticResource SectionTitleText}" />
        <ui:Card Padding="16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="IP 地址" Style="{StaticResource FieldLabelText}" />
                        <ui:TextBox Text="{Binding SubnetIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="192.168.1.66" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="子网掩码" Style="{StaticResource FieldLabelText}" />
                        <ui:TextBox Text="{Binding SubnetMask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="255.255.255.0 或 /24" />
                    </StackPanel>
                    <ui:Button Grid.Column="4" Content="计算" Appearance="Primary" MinWidth="96" Margin="0,0,0,1"
                               VerticalAlignment="Bottom" Command="{Binding CalculateSubnetCommand}" />
                </Grid>
                <TextBlock Text="{Binding SubnetError}" FontSize="12" Foreground="#E25B5B" Margin="0,8,0,0" />
                <ItemsControl ItemsSource="{Binding SubnetResults}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Padding="12,8" Margin="0,0,10,10"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" MinWidth="150">
                                <StackPanel>
                                    <TextBlock Text="{Binding Key}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:Card>

    </StackPanel>
</Page>
