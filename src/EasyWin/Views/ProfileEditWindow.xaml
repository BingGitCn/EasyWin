<ui:FluentWindow x:Class="EasyWin.Views.ProfileEditWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="编辑方案"
                 Width="500"
                 SizeToContent="Height"
                 MaxHeight="700"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="{DynamicResource AppFont}">

    <Grid Margin="20,4,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Padding="0,6" Background="Transparent" />

        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock Text="方案名称" Style="{StaticResource FieldLabelText}" />
            <ui:TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例如:公司网络 / 实验室静态 IP" />

            <TextBlock Text="目标网卡" Style="{StaticResource FieldLabelText}" Margin="0,14,0,0" />
            <ComboBox x:Name="AdapterBox"
                      ItemsSource="{Binding AdapterNames}"
                      SelectedItem="{Binding AdapterName, Mode=TwoWay}" />

            <TextBlock Text="IP 模式" Style="{StaticResource FieldLabelText}" Margin="0,14,0,0" />
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="DHCP 自动获取" GroupName="Mode" Margin="0,0,24,0"
                             IsChecked="{Binding IsDhcp, Mode=TwoWay}" />
                <RadioButton Content="静态 IP" GroupName="Mode"
                             IsChecked="{Binding IsStatic, Mode=TwoWay}" />
            </StackPanel>

            <Grid IsEnabled="{Binding IsStatic}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="IP 地址" Style="{StaticResource FieldLabelText}" />
                    <ui:TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="192.168.1.100" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="子网掩码" Style="{StaticResource FieldLabelText}" />
                    <ui:TextBox Text="{Binding SubnetMask, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="255.255.255.0" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="默认网关(可留空)" Style="{StaticResource FieldLabelText}" />
                    <ui:TextBox Text="{Binding Gateway, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="192.168.1.1" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="首选 DNS(可留空)" Style="{StaticResource FieldLabelText}" />
                    <ui:TextBox Text="{Binding Dns1, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="223.5.5.5" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="0">
                    <TextBlock Text="备用 DNS(可留空)" Style="{StaticResource FieldLabelText}" />
                    <ui:TextBox Text="{Binding Dns2, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="114.114.114.114" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="取消" Appearance="Secondary" Padding="20,7"
                           IsCancel="True" />
                <ui:Button Grid.Column="1" Content="保存方案" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Padding="20,7"
                           IsDefault="True" Click="OnSave" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
