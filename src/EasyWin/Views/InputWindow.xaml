<ui:FluentWindow x:Class="EasyWin.Views.InputWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="440"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Title="输入"
                 FontFamily="{DynamicResource AppFont}">

    <StackPanel Margin="20,60,20,18">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" FontSize="14"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <ui:TextBox x:Name="ValueBox" Margin="0,12,0,0" KeyDown="OnValueKeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="取消" Appearance="Secondary" Padding="18,6" Margin="0,0,10,0" Click="OnCancelClick" />
            <ui:Button Content="确定" Appearance="Primary" Padding="18,6" Click="OnOkClick" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
