<Page x:Class="EasyWin.Views.RdpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:EasyWin.Controls"
      mc:Ignorable="d"
      d:DesignHeight="700"
      d:DesignWidth="1000">

    <Grid Margin="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题与工具栏 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="导入" Icon="{ui:SymbolIcon ArrowUpload24}" Appearance="Secondary" Margin="0,0,8,0"
                           Command="{Binding ImportProfilesCommand}" />
                <ui:Button Content="导出" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Secondary" Margin="0,0,8,0"
                           Command="{Binding ExportProfilesCommand}" />
                <ui:Button Content="新建连接" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                           Command="{Binding NewCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="远程桌面" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="保存 mstsc 连接配置,一键发起远程控制" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- 页面滚动统一交给 NavigationView 外层滚动器(内层 SV 会被导航布局撑开,导致滚轮失效) -->
        <StackPanel Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Profiles}" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- ItemWidth/ItemHeight 强制所有卡片格子等大 -->
                            <WrapPanel ItemWidth="318" ItemHeight="220" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Width="306" Height="208" Margin="0,0,12,12" Padding="16"
                                 Style="{StaticResource LiftCard}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ui:Button Icon="{ui:SymbolIcon Edit24}" Appearance="Secondary" Padding="8,5" Margin="0,0,6,0"
                                                   ToolTip="编辑"
                                                   Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Padding="8,5"
                                                   ToolTip="删除"
                                                   Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Content="一键连接" Icon="{ui:SymbolIcon ArrowRight24}" Appearance="Primary"
                                                   Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Content="唤醒连接" Icon="{ui:SymbolIcon Power24}" Appearance="Secondary" Padding="12,6" Margin="8,0,0,0"
                                                   ToolTip="广播网络唤醒魔术包,设备上线后自动发起连接(需在连接里填写 MAC)"
                                                   Visibility="{Binding HasMac, Converter={StaticResource BoolToVis}}"
                                                   Command="{Binding DataContext.WakeAndConnectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DockPanel>

                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="4" Padding="8,2"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayText}" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>

                                    <TextBlock Margin="0,8,0,0" FontSize="13" FontWeight="SemiBold"
                                               Text="{Binding Server}" TextTrimming="CharacterEllipsis" />

                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionText}">
                                        <Run Text="用户:" />
                                        <Run Text="{Binding UserName, Mode=OneWay, TargetNullValue=连接时输入}" />
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border CornerRadius="4" Padding="8,2" Margin="0,0,6,0"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <Run Text="凭据:" />
                                                <Run Text="{Binding RememberPassword, Mode=OneWay, Converter={StaticResource BoolToRemember}}" />
                                            </TextBlock>
                                        </Border>
                                        <Border CornerRadius="4" Padding="8,2" Margin="0,0,6,0"
                                                Background="#33E2B93B"
                                                Visibility="{Binding AdminSession, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="管理模式" FontSize="11" Foreground="#E2B93B" />
                                        </Border>
                                        <Border CornerRadius="4" Padding="8,2"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                ToolTip="已配置 MAC,支持网络唤醒"
                                                Visibility="{Binding HasMac, Converter={StaticResource BoolToVis}}">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <Run Text="MAC " />
                                                <Run Text="{Binding Mac, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 远程工具:第三方远控,已安装可直接打开,未安装可去官网下载 -->
                <TextBlock Text="远程工具" Style="{StaticResource SectionTitleText}" Margin="0,20,0,0" />
                <TextBlock Text="第三方远程控制工具,已安装的可直接打开,未安装可前往官网下载"
                           Style="{StaticResource CaptionText}" Margin="0,2,0,10" />
                <ItemsControl ItemsSource="{Binding Tools}" HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="318" ItemHeight="220" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Width="306" Height="208" Margin="0,0,12,12" Padding="16"
                                     Style="{StaticResource LiftCard}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                        <ui:Button DockPanel.Dock="Right" Content="官网" Icon="{ui:SymbolIcon Link24}"
                                                   Appearance="Secondary" Padding="10,5"
                                                   ToolTip="打开官网"
                                                   Command="{Binding DataContext.OpenToolWebsiteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Content="打开" Icon="{ui:SymbolIcon ArrowRight24}" Appearance="Primary"
                                                   HorizontalAlignment="Left" Padding="14,5"
                                                   IsEnabled="{Binding Installed}"
                                                   ToolTip="启动本机已安装的程序"
                                                   Command="{Binding DataContext.OpenToolCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                    </DockPanel>

                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="42" Height="42" CornerRadius="8"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                <Grid>
                                                    <Image Source="{Binding Icon}" Width="30" Height="30"
                                                           Visibility="{Binding Icon, Converter={StaticResource NotNullToVis}}" />
                                                    <ui:SymbolIcon Symbol="Desktop24" FontSize="20">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </Grid>
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Border CornerRadius="4" Padding="8,2" Margin="0,0,6,0"
                                                    Background="#334CC38A"
                                                    Visibility="{Binding Installed, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="已安装" FontSize="11" Foreground="#7ADFA9" />
                                            </Border>
                                            <Border CornerRadius="4" Padding="8,2"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Installed}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="未安装" FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
        </StackPanel>

        <!-- 空态 -->
        <controls:EmptyState Grid.Row="1"
                             Symbol="Desktop24"
                             Title="还没有远程桌面连接"
                             Caption="点击右上角「新建连接」保存常用的 mstsc 配置(服务器/用户/分辨率),之后一键发起远程控制"
                             VerticalAlignment="Top" Margin="0,80,0,0">
            <controls:EmptyState.Style>
                <Style TargetType="controls:EmptyState">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Profiles.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:EmptyState.Style>
        </controls:EmptyState>
    </Grid>
</Page>
