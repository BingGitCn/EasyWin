<ui:FluentWindow x:Class="EasyWin.Views.RdpEditWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="编辑连接"
                 Width="480"
                 SizeToContent="Height"
                 MaxHeight="720"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="{DynamicResource AppFont}">

    <Grid Margin="20,4,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Padding="0,6" Background="Transparent" />

        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock Text="连接名称" Style="{StaticResource FieldLabelText}" />
            <ui:TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例如:公司服务器 / 实验室主机" />

            <TextBlock Text="服务器地址(IP 或 域名,可带端口)" Style="{StaticResource FieldLabelText}" Margin="0,14,0,0" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="ServerBox" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="192.168.1.100 或 srv.example.com:3390" />
                <ui:Button x:Name="ScanButton" Grid.Column="2" Appearance="Secondary" ToolTip="扫描本网段开放远程桌面的设备" AutomationProperties.Name="扫描局域网"
                           Icon="{ui:SymbolIcon Search24}" Click="OnScanClick" />

                <!-- 扫描结果下拉 -->
                <Popup x:Name="ScanPopup" PlacementTarget="{Binding ElementName=ServerBox}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                            BorderBrush="#33FFFFFF" BorderThickness="1"
                            CornerRadius="8" Margin="0,4,8,8" Padding="8"
                            MinWidth="320" MaxHeight="260">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="ScanStatusText" Text="正在扫描本网段…" Margin="6,4" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ListBox x:Name="ScanList" Background="Transparent" BorderThickness="0"
                                     SelectionChanged="OnScanItemSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2,4">
                                            <ui:SymbolIcon Symbol="Desktop24" FontSize="15"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Ip}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding Hostname}" FontSize="11" Margin="10,0,0,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                            <TextBlock Text="RDP" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Foreground="#7ADFA9" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <TextBlock Text="用户名(可留空,连接时输入)" Style="{StaticResource FieldLabelText}" Margin="0,14,0,0" />
            <ui:TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="administrator" />

            <TextBlock Text="密码(配合下方记住凭据,可免密登录)" Style="{StaticResource FieldLabelText}" Margin="0,14,0,0" />
            <PasswordBox x:Name="PasswordBox" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <CheckBox Content="记住凭据(写入 Windows 凭据管理器)" IsChecked="{Binding RememberPassword, Mode=TwoWay}" />
            </StackPanel>

            <Separator Margin="0,16" Background="#22FFFFFF" />

            <StackPanel Orientation="Horizontal">
                <CheckBox Content="全屏显示" IsChecked="{Binding FullScreen, Mode=TwoWay}" />
                <CheckBox Content="管理员会话(/admin)" Margin="24,0,0,0" IsChecked="{Binding AdminSession, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0" IsEnabled="{Binding IsWindowed, Converter={StaticResource InverseBool}}">
                <TextBlock Text="窗口分辨率" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ui:TextBox Width="90" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="1280" />
                <TextBlock Text="×" Margin="6,0" VerticalAlignment="Center" />
                <ui:TextBox Width="90" Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="800" />
            </StackPanel>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="取消" Appearance="Secondary" Padding="20,7" IsCancel="True" />
                <ui:Button Grid.Column="1" Content="保存连接" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Padding="20,7"
                           IsDefault="True" Click="OnSave" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
