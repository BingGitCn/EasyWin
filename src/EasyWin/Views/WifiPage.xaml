<Page
    x:Class="EasyWin.Views.WifiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <Grid Margin="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题与工具栏  -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <ui:ProgressRing
                    Width="16"
                    Height="16"
                    Margin="0,0,10,0"
                    IsIndeterminate="True"
                    Visibility="{Binding IsWifiScanning, Converter={StaticResource BoolToVis}}" />
                <ui:Button
                    Appearance="Secondary"
                    Command="{Binding RefreshCommand}"
                    Content="重新扫描"
                    Icon="{ui:SymbolIcon ArrowSync24}"
                    IsEnabled="{Binding IsWifiScanning, Converter={StaticResource InverseBool}}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleText}" Text="Wi-Fi 快速切换" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource CaptionText}"
                    Text="{Binding CurrentWifiText}" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  已保存的 Wi-Fi 密码  -->
                <TextBlock
                    Margin="0,16,0,10"
                    Style="{StaticResource SectionTitleText}"
                    Text="已保存的 Wi-Fi 密码" />
                <ui:Card
                    Width="592"
                    Margin="0,0,0,24"
                    Padding="18"
                    HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelText}" Text="本机保存过密码的网络" />
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Orientation="Horizontal">
                                <ui:Button
                                    Margin="8,0,8,0"
                                    Appearance="Primary"
                                    Command="{Binding ShowSavedPasswordCommand}"
                                    Content="查看密码"
                                    Icon="{ui:SymbolIcon Eye24}" />
                                <ui:Button
                                    Appearance="Secondary"
                                    Command="{Binding CopySavedPasswordCommand}"
                                    Content="复制"
                                    Icon="{ui:SymbolIcon Copy24}" />
                            </StackPanel>
                            <ComboBox
                                Width="330"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding SavedProfiles}"
                                SelectedItem="{Binding SelectedSavedProfile, Mode=TwoWay}" />
                        </DockPanel>
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="{Binding SavedPasswordText}"
                            TextWrapping="Wrap"
                            Visibility="{Binding SavedPasswordText, Converter={StaticResource NotNullToVis}}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource CaptionText}"
                            Text="查看的是 Windows 本机存储的明文密码,注意保密;开放网络无密码" />
                    </StackPanel>
                </ui:Card>


                <ItemsControl HorizontalAlignment="Left" ItemsSource="{Binding Networks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Width="560"
                                Margin="0,0,0,8"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="RowBg"
                                            Padding="16,12"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="#22FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowBg" Property="Background" Value="#26FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Symbol="{Binding SignalSymbol}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{Binding Ssid}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding Auth}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{Binding SignalText}" />
                                    <Border
                                        Grid.Column="4"
                                        Margin="12,0,0,0"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Background="#334CC38A"
                                        CornerRadius="4"
                                        Visibility="{Binding Connected, Converter={StaticResource BoolToVis}}">
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="#7ADFA9"
                                            Text="已连接" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!--  空态:有 WLAN 且列表为空时显示  -->
        <TextBlock
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="14"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Text="附近暂未发现 Wi-Fi 网络,点击右上角「重新扫描」再试">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsWlanAvailable}" Value="True" />
                                <Condition Binding="{Binding Networks.Count}" Value="0" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Page>
