<Page x:Class="EasyWin.Views.UsageStatsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="800"
      d:DesignWidth="1000">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="RangeButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Secondary" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RangeText}" Value="今日">
                    <Setter Property="Appearance" Value="Primary" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RangeText}" Value="近 7 天">
                    <Setter Property="Appearance" Value="Primary" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RangeText}" Value="近 30 天">
                    <Setter Property="Appearance" Value="Primary" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <StackPanel Margin="24,8,24,24" MaxWidth="900" HorizontalAlignment="Left">

        <TextBlock Text="使用统计" Style="{StaticResource PageTitleText}" />
        <TextBlock Text="记录各软件的使用时长(轻量版,理念参考 Planshit/Tai);数据仅存本机,无任何网络上传"
                   Style="{StaticResource CaptionText}" Margin="0,4,0,0" />

        <!--  开关  -->
        <ui:Card Padding="16" Margin="0,12,0,10">
            <DockPanel>
                <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding TrackingEnabled, Mode=TwoWay}"
                                 ToolTip="托盘常驻期间每 15 秒采样前台窗口;无输入 5 分钟视为离开不计入" />
                <StackPanel>
                    <TextBlock Text="开启使用统计" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="需要 EasyWin 常驻后台(托盘);只记录前台进程名和累计秒数,保留最近 30 天"
                               Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </ui:Card>

        <!--  范围与汇总  -->
        <ui:Card Padding="16" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="今日" Margin="0,0,8,0" Style="{StaticResource RangeButtonStyle}"
                               Command="{Binding SelectRangeCommand}" CommandParameter="today" />
                    <ui:Button Content="近 7 天" Margin="0,0,8,0" Style="{StaticResource RangeButtonStyle}"
                               Command="{Binding SelectRangeCommand}" CommandParameter="week" />
                    <ui:Button Content="近 30 天" Style="{StaticResource RangeButtonStyle}"
                               Command="{Binding SelectRangeCommand}" CommandParameter="month" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding RangeText}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </ui:Card>

        <!--  排行榜  -->
        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:Card Margin="0,0,0,10" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Rank}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Process}" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Process}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <ProgressBar Grid.Column="2" Maximum="100" Minimum="0" Value="{Binding Percent}"
                                         Height="10" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Percent, StringFormat={}{0}%}" FontSize="12" Margin="0,0,14,0" Width="52"
                                           TextAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding DurationText}" FontSize="12" Width="110" TextAlignment="Right"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  空状态  -->
        <ui:Card Padding="28" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="还没有数据" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </ui:Card>

    </StackPanel>
</Page>
